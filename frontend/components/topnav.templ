package components

templ TopNav(searchPlaceholder string) {
	<header class="flex justify-between items-center h-16 px-xl bg-surface z-40 sticky top-0 border-b border-outline-variant/30">
		<div class="flex items-center flex-1 max-w-2xl">
			<div class="relative w-full max-w-xs">
				<span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
				<input
					class="w-full pl-3xl pr-md py-sm bg-surface-container-lowest border border-outline-variant focus:border-primary focus:ring-0 text-body-md transition-all"
					placeholder={ searchPlaceholder }
					type="text"
				/>
			</div>
		</div>
		<div class="flex items-center gap-lg ml-xl">
			<nav class="flex gap-lg font-label-sm text-label-sm">
				<a class="text-on-surface-variant hover:text-primary transition-all" href="#">Dashboard</a>
				<a class="text-on-surface-variant hover:text-primary transition-all" href="#">Reports</a>
			</nav>
			<div class="h-6 w-[1px] bg-outline-variant"></div>
			<div class="flex items-center gap-md">
				<button class="text-on-surface-variant hover:text-primary transition-all active:scale-90">
					<span class="material-symbols-outlined">notifications</span>
				</button>
				<button class="text-on-surface-variant hover:text-primary transition-all active:scale-90">
					<span class="material-symbols-outlined">history</span>
				</button>
				<div class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold text-[13px]">
					AS
				</div>
			</div>
		</div>
	</header>
}
