package components

templ Layout(title string) {
	<!DOCTYPE html>
	<html class="light" lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
			<title>{ title } — Themis Legal</title>
			<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;500;600;700&display=swap" rel="stylesheet"/>
			<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
			<style>
				.material-symbols-outlined {
					font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
					vertical-align: middle;
				}
				body { background-color: #f7f9fb; }
			</style>
			<script id="tailwind-config">
				tailwind.config = {
					darkMode: "class",
					theme: {
						extend: {
							colors: {
								"tertiary": "#071626",
								"on-tertiary-fixed": "#0d1c2d",
								"outline": "#74777d",
								"secondary-fixed-dim": "#b7c8e1",
								"secondary-fixed": "#d3e4fe",
								"surface": "#f7f9fb",
								"surface-bright": "#f7f9fb",
								"on-secondary": "#ffffff",
								"on-surface-variant": "#44474c",
								"secondary-container": "#d0e1fb",
								"on-primary-fixed": "#0b1d2d",
								"primary-container": "#1a2b3c",
								"on-primary-container": "#8192a7",
								"primary": "#041627",
								"primary-fixed-dim": "#b7c8de",
								"on-tertiary-fixed-variant": "#39485a",
								"surface-container-lowest": "#ffffff",
								"on-secondary-fixed": "#0b1c30",
								"on-error-container": "#93000a",
								"surface-container-low": "#f2f4f6",
								"background": "#f7f9fb",
								"tertiary-fixed": "#d4e4fa",
								"on-secondary-container": "#54647a",
								"on-primary-fixed-variant": "#38485a",
								"error": "#ba1a1a",
								"secondary": "#505f76",
								"inverse-surface": "#2d3133",
								"surface-container-highest": "#e0e3e5",
								"on-primary": "#ffffff",
								"surface-tint": "#4f6073",
								"surface-container-high": "#e6e8ea",
								"surface-container": "#eceef0",
								"on-secondary-fixed-variant": "#38485d",
								"on-tertiary-container": "#8392a7",
								"on-tertiary": "#ffffff",
								"surface-dim": "#d8dadc",
								"error-container": "#ffdad6",
								"on-background": "#191c1e",
								"tertiary-fixed-dim": "#b9c8de",
								"tertiary-container": "#1c2b3c",
								"outline-variant": "#c4c6cd",
								"primary-fixed": "#d2e4fb",
								"inverse-on-surface": "#eff1f3",
								"on-error": "#ffffff",
								"on-surface": "#191c1e",
								"surface-variant": "#e0e3e5",
								"inverse-primary": "#b7c8de"
							},
							borderRadius: {
								"DEFAULT": "0.125rem",
								"lg": "0.25rem",
								"xl": "0.5rem",
								"full": "0.75rem"
							},
							spacing: {
								"gutter": "24px",
								"sm": "8px",
								"lg": "24px",
								"unit": "4px",
								"sidebar_width": "280px",
								"xl": "32px",
								"3xl": "64px",
								"xs": "4px",
								"md": "16px",
								"2xl": "48px"
							},
							fontFamily: {
								"headline-md": ["Newsreader"],
								"headline-lg": ["Newsreader"],
								"body-lg": ["Inter"],
								"body-md": ["Inter"],
								"display-xl": ["Newsreader"],
								"label-sm": ["Inter"]
							},
							fontSize: {
								"headline-md": ["24px", {"lineHeight": "1.3", "fontWeight": "500"}],
								"headline-lg": ["32px", {"lineHeight": "1.2", "fontWeight": "600"}],
								"body-lg": ["18px", {"lineHeight": "1.6", "fontWeight": "400"}],
								"body-md": ["16px", {"lineHeight": "1.5", "fontWeight": "400"}],
								"display-xl": ["48px", {"lineHeight": "1.1", "fontWeight": "600"}],
								"label-sm": ["13px", {"lineHeight": "1.2", "letterSpacing": "0.05em", "fontWeight": "600"}]
							}
						}
					}
				}
			</script>
		</head>
		<body class="font-body-md text-on-surface">
			{ children... }
		</body>
	</html>
}
